<?xml version="1.0" encoding="UTF-8"?>
<!--
  Esquema XSD per a la validació d'entregas de fotografies
  Memòria Visual de Vila-real
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Element arrel -->
  <xs:element name="fotografia">
    <xs:complexType>
      <xs:all>
        <!-- Identificador únic: obligatori, text no buit -->
        <xs:element name="id" type="xs:string" />

        <!-- Títol: obligatori -->
        <xs:element name="titol" type="xs:string" />

        <!-- Arxiu d'imatge: obligatori, ha de ser .jpg, .jpeg o .png -->
        <xs:element name="arxiu_imatge">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value=".+\.(jpg|jpeg|png|JPG|JPEG|PNG)" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>

        <!-- Any: obligatori, entre 1840 i 2025, amb atribut 'exacte' -->
        <xs:element name="any">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="anyRangeType">
                <xs:attribute name="exacte" type="xs:boolean" use="optional" default="true" />
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>

        <!-- Categoria: obligatori, restringida a valors admesos -->
        <xs:element name="categoria">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="arquitectura" />
              <xs:enumeration value="infraestructura" />
              <xs:enumeration value="vida quotidiana" />
              <xs:enumeration value="esdeveniments" />
              <xs:enumeration value="personatges" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>

        <!-- Geolocalització: obligatori (latitud i longitud) -->
        <xs:element name="geolocalitzacio">
          <xs:complexType>
            <xs:all>
              <xs:element name="latitud" type="xs:decimal" />
              <xs:element name="longitud" type="xs:decimal" />
              <xs:element name="toponim_historic" type="xs:string" minOccurs="0" />
              <xs:element name="carrer_actual" type="xs:string" minOccurs="0" />
            </xs:all>
          </xs:complexType>
        </xs:element>

        <!-- Descripció: obligatori -->
        <xs:element name="descripcio" type="xs:string" />

        <!-- Temes: opcional, llista de temes -->
        <xs:element name="temes" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="tema" type="xs:string" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Personatges: opcional, llista de persones -->
        <xs:element name="personatges" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="personatge" type="xs:string" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Dades de l'alumne/a: obligatori -->
        <xs:element name="alumne">
          <xs:complexType>
            <xs:all>
              <xs:element name="nom" type="xs:string" />
              <xs:element name="curs" type="xs:string" />
            </xs:all>
          </xs:complexType>
        </xs:element>

        <!-- Donant / Procedència: opcional -->
        <xs:element name="donant" type="xs:string" minOccurs="0" />

        <!-- Elements / Regions anotades en la imatge: opcional -->
        <xs:element name="elements_imatge" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="element" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="nom" type="xs:string" />
                    <xs:element name="descripcio" type="xs:string" minOccurs="0" />
                    <xs:element name="regio">
                      <xs:complexType>
                        <xs:attribute name="x" type="percentType" use="required" />
                        <xs:attribute name="y" type="percentType" use="required" />
                        <xs:attribute name="ample" type="percentType" use="required" />
                        <xs:attribute name="alt" type="percentType" use="required" />
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:string" use="optional" />
                  <xs:attribute name="tipus" use="required">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="persona" />
                        <xs:enumeration value="edifici" />
                        <xs:enumeration value="vehicle" />
                        <xs:enumeration value="objecte" />
                        <xs:enumeration value="altre" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- Tipus personalitzat per a l'any (1840 - 2025) -->
  <xs:simpleType name="anyRangeType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1840" />
      <xs:maxInclusive value="2025" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipus personalitzat per a coordenades en percentatge (0.0 a 100.0) -->
  <xs:simpleType name="percentType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0" />
      <xs:maxInclusive value="100.0" />
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
